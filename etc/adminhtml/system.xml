<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="arjun_currency_converter"
                 translate="label"
                 type="text"
                 sortOrder="90"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">
            <label>Currency Exchange Converter</label>
            <tab>general</tab>
            <resource>Arjun_CurrencyConverter::config</resource>
            <group id="general"
                   translate="label"
                   type="text"
                   sortOrder="10"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>General Settings</label>
                <field id="enabled"
                       translate="label comment"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Enable Currency Converter</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enable or disable the storefront currency converter page and API endpoints.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
